{
  "name": "maxintensity",
  "version": "1.0.0",
  "private": true,
  "description": "Max Intensity \u2014 the web app and its iOS wrap (Capacitor).",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "icons": "node scripts/make-icons.js",
    "test": "cd tests && npm test",
    "test:bundle": "npm run build:web && cd tests && node bundle.js"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@babel/standalone": "^7.23.5",
    "@tailwindcss/browser": "^4.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
